# Aaina — Environment Variables
# Copy this file to .env and fill in the values

# Gemini API Key (required for Garment Intelligence & Style Advisor)
GEMINI_API_KEY=

# Gemini Model IDs (defaults shown; override if your key supports different models)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Optional: Hugging Face token for higher GPU quota (free account token)
# Never required — the app works without it using anonymous quota
HF_TOKEN=
